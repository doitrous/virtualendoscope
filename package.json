{
  "name": "virtualendoscope",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://virtualendoscope.doitrous.com/",
  "repository": "github:doitrous/virtualendoscope",
  "bugs": "https://github.com/doitrous/virtualendoscope/issues",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve-training.mjs",
    "start:prototype": "node prototypes/upper-gi-mesh/preview.mjs",
    "build": "node scripts/build-training.mjs",
    "preview": "node scripts/serve-training.mjs --dist",
    "test": "node --test prototypes/upper-gi-mesh/*.test.mjs scripts/*.test.mjs training/*.test.mjs",
    "prepare:training": "node training/prepare-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.159.0",
    "@fontsource-variable/figtree": "5.3.0"
  }
